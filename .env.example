# ─── CallAgent environment ─────────────────────────────────────────────────
# Copy to `.env.local` for local dev. On Vercel: Project → Settings →
# Environment Variables. When these are ABSENT the app runs in DEMO mode:
# demo auth (localStorage), demo Paddle checkout modal, and simulated calls.
# API keys are server-side only — never expose them with NEXT_PUBLIC_.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (database + real auth — activates when set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs (real AI voice calls — activates when set)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_DISPATCHER=
ELEVENLABS_AGENT_ID_BRAND=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Twilio (platform phone numbers imported into ElevenLabs)
TWILIO_ACCOUNT_SID=

# Paddle (subscriptions + payments — sandbox first, then live)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
